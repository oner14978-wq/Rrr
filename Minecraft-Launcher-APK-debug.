
name: Build Minecraft Launcher APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 120

    steps:
      - name: Baixar arquivos do repositório
        uses: actions/checkout@v4

      - name: Juntar as partes do projeto
        run: |
          cat project.zip.part* > project.zip
          unzip -q project.zip -d extracted
          test -f extracted/PojavLauncher-gladiolus/gradlew

      - name: Instalar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar ferramentas Android
        run: |
          yes | sdkmanager --licenses
          sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0" "ndk;25.2.9519653"

      - name: Compilar APK
        run: |
          cd extracted/PojavLauncher-gladiolus
          chmod +x gradlew
          ./gradlew --no-daemon :app_pojavlauncher:assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: Minecraft-Launcher-APK-debug
          path: extracted/PojavLauncher-gladiolus/app_pojavlauncher/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 7
          
